{
  "$schema": "https://francesco.belacca.com/status.schema.json",
  "contract_version": "belacca.synthetic-contracts.v1",
  "environment": "native-production",
  "availability_policy": "Each public service targets 99% availability over 30d; this is not an SLA.",
  "external_slo_source": {
    "kind": "external-durable-synthetic-probe",
    "status": "proposed",
    "required_for_slo_measurement": true,
    "ingested_into_prometheus": false,
    "status_repository_scraped": false,
    "note": "The status Git repository is a publication target, not a Prometheus scrape source. Prometheus native metrics are diagnostics and do not calculate public availability."
  },
  "privacy": {
    "store_room_ids": false,
    "store_player_names": false,
    "store_client_addresses": false,
    "store_tokens": false,
    "store_response_bodies": false
  },
  "checks": [
    {
      "id": "portfolio-health",
      "service": "portfolio",
      "method": "GET",
      "path": "/health",
      "expected": "HTTP 200 and body ok",
      "source": "external durable synthetic runner",
      "slo_eligible": true
    },
    {
      "id": "pong-user-journey",
      "service": "pong",
      "method": "WORKFLOW",
      "path": "/api/rooms/create -> /api/rooms/join -> /rooms/<id>/ws",
      "expected": "public homepage and API success, room CRUD, two unique player assignments, playing state, and room cleanup",
      "source": "external durable synthetic runner using cloudnativepong/scripts/synthetic-check.mjs",
      "slo_eligible": true
    },
    {
      "id": "analytics-status",
      "service": "analytics",
      "method": "GET",
      "path": "/status",
      "expected": "HTTP 200",
      "source": "external durable synthetic runner",
      "slo_eligible": true
    },
    {
      "id": "dashboard-authenticated",
      "service": "dashboard",
      "method": "AUTHENTICATED_GET",
      "path": "/",
      "expected": "authenticated dashboard response; redirect-only is not success",
      "source": "external-only operator-managed identity probe",
      "slo_eligible": false,
      "status": "proposed",
      "deployment_status": "external-only/not-deployed",
      "credentials_in_git": false
    }
  ]
}

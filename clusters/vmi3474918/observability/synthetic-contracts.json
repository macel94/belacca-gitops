{
  "$schema": "https://francesco.belacca.com/status.schema.json",
  "contract_version": "belacca.synthetic-contracts.v1",
  "publisher": "Pong GitHub Actions runner is active; portfolio, analytics, and dashboard runners remain external",
  "privacy": {
    "store_room_ids": false,
    "store_player_names": false,
    "store_client_addresses": false,
    "store_tokens": false,
    "store_response_bodies": false
  },
  "checks": [
    {
      "id": "portfolio-health",
      "service": "portfolio",
      "method": "GET",
      "path": "/health",
      "expected": "HTTP 200 and body ok",
      "source": "external synthetic runner",
      "slo_eligible": true
    },
    {
      "id": "portfolio-homepage",
      "service": "portfolio",
      "method": "GET",
      "path": "/",
      "expected": "HTTP 200 and expected document marker",
      "source": "external synthetic runner",
      "slo_eligible": true
    },
    {
      "id": "pong-user-journey",
      "service": "pong",
      "method": "WORKFLOW",
      "path": "/api/rooms/create -> /api/rooms/join -> /rooms/<id>/ws",
      "expected": "homepage and health success, room CRUD, two unique player assignments, playing state, and room cleanup",
      "source": "cloudnativepong/scripts/synthetic-check.mjs",
      "slo_eligible": true
    },
    {
      "id": "analytics-status",
      "service": "analytics",
      "method": "GET",
      "path": "/status",
      "expected": "HTTP 200",
      "source": "external synthetic runner",
      "slo_eligible": true
    },
    {
      "id": "dashboard-authenticated",
      "service": "dashboard",
      "method": "AUTHENTICATED_GET",
      "path": "/",
      "expected": "authenticated dashboard response; redirect-only is not success",
      "source": "external runner with operator-managed identity",
      "slo_eligible": true,
      "credentials_in_git": false
    }
  ]
}

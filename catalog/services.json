{
  "apiVersion": "belacca.com/v1alpha1",
  "kind": "ServiceCatalog",
  "metadata": {
    "cluster": "belacca-native",
    "sourceOfTruth": "belacca-gitops",
    "status": "initial-operational-metadata"
  },
  "services": [
    {
      "id": "portfolio",
      "name": "Francesco Belacca portfolio",
      "owner": "platform",
      "publicHosts": [
        "francesco.belacca.com",
        "belacca.com",
        "www.belacca.com",
        "www.francesco.belacca.com"
      ],
      "tier": "tier-1",
      "dependencies": [
        {
          "name": "Traefik",
          "kind": "platform",
          "required": true
        },
        {
          "name": "GoatCounter analytics",
          "kind": "optional-application-dependency",
          "required": false
        }
      ],
      "slo": {
        "status": "proposed",
        "target": "99%",
        "window": "30d",
        "indicator": "Successful HTTPS GET /health and homepage responses from an external probe",
        "measurement": "External durable evidence is not operational; establish and retain a 30-day external probe history before treating this as a measured SLO"
      },
      "rto": "4h",
      "rpo": "N/A (stateless image and GitOps configuration)",
      "dashboard": {
        "url": "https://dashboard.belacca.com/",
        "access": "OAuth2-protected Headlamp; cluster workload view, not a service-specific metrics dashboard"
      },
      "runbook": "docs/RELIABILITY.md#portfolio",
      "implementation": "clusters/belacca-production/native-applications.yaml (source: francesco-belacca-site/deploy)"
    },
    {
      "id": "pong",
      "name": "Cloud Native Pong",
      "owner": "platform",
      "publicHosts": [
        "pong.belacca.com"
      ],
      "tier": "tier-1",
      "dependencies": [
        {
          "name": "Traefik",
          "kind": "platform",
          "required": true
        },
        {
          "name": "pong-gateway",
          "kind": "workload",
          "required": true
        },
        {
          "name": "pong-api",
          "kind": "workload",
          "required": true
        },
        {
          "name": "dynamic room Pods and Services",
          "kind": "workload",
          "required": true
        },
        {
          "name": "pong-api-data PVC (SQLite)",
          "kind": "stateful-storage",
          "required": true
        }
      ],
      "slo": {
        "status": "proposed",
        "target": "99%",
        "window": "30d",
        "indicator": "Successful HTTPS GET /api/rooms plus successful create, join, and two-player real-time synthetic journey",
        "measurement": "A synthetic runner may execute the public journey, but durable 30-day external evidence is not operational; native WebTransport is optional and the SLO remains not measured"
      },
      "rto": "4h",
      "rpo": "24h target (manual verified SQLite backup; isolated restore rehearsal available; object-storage automation is not deployed)",
      "dashboard": {
        "url": "https://dashboard.belacca.com/",
        "access": "OAuth2-protected Headlamp; inspect pong workloads, events, PVC, and Flux state"
      },
      "runbook": "docs/RELIABILITY.md#pong",
      "implementation": "clusters/belacca-production/native-applications.yaml (source: cloudnativepong/k8s/overlays/native-staging)"
    },
    {
      "id": "analytics",
      "name": "GoatCounter analytics",
      "owner": "platform",
      "publicHosts": [
        "stats.belacca.com"
      ],
      "tier": "tier-2",
      "dependencies": [
        {
          "name": "Traefik",
          "kind": "platform",
          "required": true
        },
        {
          "name": "goatcounter StatefulSet",
          "kind": "workload",
          "required": true
        },
        {
          "name": "goatcounter-data PVC (SQLite)",
          "kind": "stateful-storage",
          "required": true
        },
        {
          "name": "goatcounter-admin Secret",
          "kind": "out-of-band-secret",
          "required": true
        },
        {
          "name": "analytics-dex-oauth Secret",
          "kind": "out-of-band-secret",
          "required": true
        },
        {
          "name": "Dex Google connector",
          "kind": "identity-provider",
          "required": true
        }
      ],
      "slo": {
        "status": "proposed",
        "target": "99%",
        "window": "30d",
        "indicator": "Successful HTTPS GET /status and successful same-origin /count requests",
        "measurement": "The endpoint is implemented, but durable 30-day external synthetic evidence is not operational"
      },
      "rto": "4h",
      "rpo": "24h target (manual SQLite backup; automation is not yet deployed)",
      "dashboard": {
        "url": "https://stats.belacca.com/",
        "access": "Dex SSO permits belakkuz@gmail.com; GoatCounter still requires its application session cookie for dashboard features"
      },
      "runbook": "docs/RELIABILITY.md#analytics",
      "implementation": "clusters/belacca-production/analytics"
    },
    {
      "id": "dashboard",
      "name": "Headlamp operations dashboard",
      "owner": "platform",
      "publicHosts": [
        "dashboard.belacca.com",
        "flux.belacca.com"
      ],
      "tier": "tier-2",
      "dependencies": [
        {
          "name": "Traefik",
          "kind": "platform",
          "required": true
        },
        {
          "name": "oauth2-proxy",
          "kind": "workload",
          "required": true
        },
        {
          "name": "Headlamp",
          "kind": "workload",
          "required": true
        },
        {
          "name": "Flux Web UI",
          "kind": "workload",
          "required": true
        },
        {
          "name": "Dex Google connector",
          "kind": "identity-provider",
          "required": true
        },
        {
          "name": "headlamp-dex-oauth Secret",
          "kind": "out-of-band-secret",
          "required": true
        }
      ],
      "slo": {
        "status": "proposed",
        "target": "99%",
        "window": "30d",
        "indicator": "Successful authenticated HTTPS dashboard probe",
        "measurement": "Authentication-aware durable external collection is not operational; dashboard SLO remains proposed"
      },
      "rto": "4h",
      "rpo": "GitOps configuration is versioned; the out-of-band OAuth Secret requires operator-managed backup and rotation",
      "dashboard": {
        "url": "https://dashboard.belacca.com/",
        "access": "Dex SSO permits belakkuz@gmail.com for Headlamp and Flux Web UI; Headlamp is backed by a cluster-admin ServiceAccount because this deployment mode cannot impersonate each browser user"
      },
      "runbook": "docs/RELIABILITY.md#dashboard",
      "implementation": "clusters/belacca-production/headlamp and clusters/belacca-production/routing/platform-ingress.yaml"
    }
  ]
}
